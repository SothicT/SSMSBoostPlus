<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.SearchProgressPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="320" Height="64"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <Border CornerRadius="6"
            Background="#2B2B2B"
            BorderBrush="#505050"
            BorderThickness="1"
            Padding="12,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索图标 -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="🔍" FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- 状态文字 -->
            <TextBlock x:Name="StatusText" Grid.Row="0" Grid.Column="1"
                       Text="正在执行关键词查询..."
                       FontSize="13"
                       Foreground="#E0E0E0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 进度条 -->
            <ProgressBar x:Name="ProgressBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         IsIndeterminate="True"
                         Height="3"
                         Margin="0,6,0,0"
                         Foreground="#0078D4"
                         Background="#505050"
                         BorderThickness="0"/>
        </Grid>
    </Border>
</Window>