<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.AIDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoost++ - 版本差异对比"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5"
        FontFamily="Segoe UI, Microsoft YaHei"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ScrollViewerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern button style -->
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#D0D0D0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Panel header style -->
            <Style x:Key="PanelHeader" TargetType="Border">
                <Setter Property="CornerRadius" Value="3,3,0,0"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Legend label style -->
            <Style x:Key="LegendLabel" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Summary bar ═══════════ -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="10,6" Margin="0,0,0,5"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatsText" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontSize="12" Foreground="#333"/>
                <TextBlock x:Name="LineCountText" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="10" Foreground="#999" Margin="12,0,0,0"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ═══════════ Navigation toolbar ═══════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="8,5" Margin="0,0,0,6"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <!-- Prev/Next navigation buttons -->
                <Button x:Name="PrevDiffButton" Content="◀ 上一个" Style="{StaticResource ToolbarButton}"
                        Click="PrevDiff_Click" Margin="0,0,4,0" ToolTip="上一个差异 (Alt+↑)"/>
                <Button x:Name="NextDiffButton" Content="下一个 ▶" Style="{StaticResource ToolbarButton}"
                        Click="NextDiff_Click" Margin="0,0,10,0" ToolTip="下一个差异 (Alt+↓)"/>

                <!-- Diff position -->
                <Border Background="#F0F0F0" CornerRadius="3" Padding="8,2,8,2" Margin="0,0,10,0">
                    <TextBlock x:Name="DiffPositionText" VerticalAlignment="Center" FontSize="11"
                               Foreground="#555" FontWeight="SemiBold"/>
                </Border>

                <!-- Separator -->
                <Border Width="1" Background="#E0E0E0" Margin="0,2,10,2"/>

                <!-- Scroll sync toggle -->
                <ToggleButton x:Name="SyncScrollButton" Content="🔗 同步滚动"
                              Width="90" Height="26"
                              FontSize="11"
                              IsChecked="True"
                              Background="#F5F5F5" BorderBrush="#D0D0D0"
                              BorderThickness="1"
                              Padding="8,2"
                              Cursor="Hand"
                              ToolTip="开启/关闭左右面板滚动同步"/>

                <!-- Separator -->
                <Border Width="1" Background="#E0E0E0" Margin="10,2,10,2"/>

                <!-- Legend -->
                <TextBlock Text="图例" VerticalAlignment="Center" FontSize="11" Foreground="#888"
                           Margin="0,0,8,0"/>
                <Border Background="#FFEBEE" CornerRadius="3" Padding="8,2" Margin="0,0,5,0">
                    <TextBlock Text="冲突" FontSize="10" Foreground="#C62828" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#E0F7FA" CornerRadius="3" Padding="8,2" Margin="0,0,10,0">
                    <TextBlock Text="已同步" FontSize="10" Foreground="#00838F" FontWeight="SemiBold"/>
                </Border>

                <!-- Separator -->
                <Border Width="1" Background="#E0E0E0" Margin="0,2,10,2"/>

                <!-- Sync all button -->
                <Button x:Name="SyncAllButton" Content="✓ 全部同步" Style="{StaticResource ToolbarButton}"
                        Click="SyncAll_Click" Margin="0,0,5,0"
                        ToolTip="将所有差异块从数据库版本同步到本地脚本"
                        Visibility="Collapsed"/>

                <!-- Expand All toggle -->
                <ToggleButton x:Name="ExpandAllButton" Content="⛶ 展开全部"
                              Width="90" Height="26"
                              FontSize="11"
                              Background="#F5F5F5" BorderBrush="#D0D0D0"
                              BorderThickness="1"
                              Padding="8,2"
                              Cursor="Hand"
                              IsChecked="False" Visibility="Collapsed"
                              Checked="ExpandAll_Checked" Unchecked="ExpandAll_Unchecked"
                              ToolTip="切换显示全部代码行"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ Side-by-side diff panels + Minimap ═══════════ -->
        <Grid Grid.Row="2">
            <Grid x:Name="DiffContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>      <!-- 0: Left (DB) -->
                    <ColumnDefinition Width="6"/>                      <!-- 1: Splitter -->
                    <ColumnDefinition Width="*" MinWidth="200"/>      <!-- 2: Right (Local) -->
                    <ColumnDefinition Width="22"/>                     <!-- 3: Minimap -->
                </Grid.ColumnDefinitions>

                <!-- Left Panel - DB Version (read-only) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Border Style="{StaticResource PanelHeader}" Background="#FFF0F0" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🗄" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="数据库版本（最新）"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#C62828"/>
                        </Grid>
                    </Border>
                    <!-- Content -->
                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1,0,1,1"
                            CornerRadius="0,0,3,3" Background="White">
                        <RichTextBox x:Name="LeftViewer"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="0"
                                     Focusable="False">
                            <RichTextBox.Resources>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                    <Setter Property="Foreground" Value="#1E1E1E"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </Grid>

                <!-- GridSplitter (draggable) -->
                <GridSplitter Grid.Column="1" Width="6"
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="False"
                              Margin="0,0,0,0">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Width="6">
                                <Border Width="2" Height="28"
                                        Background="#C0C0C0"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Right Panel - Your Script (editable) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Border Style="{StaticResource PanelHeader}" Background="#F0FFF0" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="我的脚本（本地）"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#2E7D32"/>
                        </Grid>
                    </Border>
                    <!-- Content -->
                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1,0,1,1"
                            CornerRadius="0,0,3,3" Background="White">
                        <RichTextBox x:Name="RightViewer"
                                     IsReadOnly="False"
                                     IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="0"
                                     Focusable="True"
                                     TextChanged="RightViewer_TextChanged"
                                     PreviewKeyDown="RightViewer_PreviewKeyDown">
                            <RichTextBox.Resources>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                    <Setter Property="Foreground" Value="#1E1E1E"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </Grid>

                <!-- Minimap Overview Panel (差异概览栏) -->
                <Border Grid.Column="3" Width="22" Margin="4,0,0,0"
                        BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="3" Background="#F8F8F8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Minimap title -->
                        <TextBlock Text="概览" FontSize="9" Foreground="#999"
                                   HorizontalAlignment="Center" Margin="0,3,0,2"/>
                        <!-- Minimap canvas -->
                        <Border Grid.Row="1" Margin="3,0,3,3"
                                Background="White" BorderBrush="#E8E8E8"
                                BorderThickness="1" CornerRadius="2">
                            <Canvas x:Name="MinimapCanvas" Width="14"
                                    Background="Transparent"
                                    MouseLeftButtonDown="Minimap_MouseDown"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Loading overlay -->
            <Grid x:Name="LoadingOverlay" Background="#F0F8FC" Visibility="Visible">
                <Border BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8"
                        Background="White" Padding="24,20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Effect="{x:Null}">
                    <StackPanel>
                        <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="正在计算差异，请稍候..." FontSize="14" FontWeight="SemiBold"
                                   Foreground="#333" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LoadingDetailText" Text="DiffPlex 引擎正在分析代码变更..."
                                   FontSize="11" Foreground="#888" HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ Bottom action buttons ═══════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="采用数据库版本" Width="145" Height="30" Margin="0,0,8,0"
                        Click="AcceptLeft_Click"
                        Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="保留我的脚本" Width="130" Height="30" Margin="0,0,8,0"
                        Click="AcceptRight_Click"
                        Background="#FF8F00" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="取消" Width="80" Height="30"
                        Click="Cancel_Click"
                        Background="#F5F5F5" Foreground="#333" FontWeight="Normal"
                        BorderBrush="#D0D0D0" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
