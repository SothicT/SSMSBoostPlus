<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.AIConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoost++ - AI 配置"
        Width="520" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ScrollViewerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="配置你的 AI 后端" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,4,0,0">
            <StackPanel>
                <!-- CodeBuddy CLI Section -->
                <Border Background="#F5F5F5" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="🤖 CodeBuddy CLI（优先使用）" FontWeight="Bold" Margin="0,0,0,6" FontSize="11"/>
                        <TextBlock Text="如果配置了 CLI 路径，SSMS 将优先使用本地 AI，无需 API Key。"
                                   Foreground="#888" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="CodeBuddy CLI 路径" Margin="0,0,0,4" FontSize="11"/>
                        <TextBox x:Name="CodebuddyCliPathBox" Margin="0,0,0,4"
                                 ToolTip="CodeBuddy CLI 可执行文件的完整路径（如 D:\node-v24.13.0\codebuddy.cmd）。留空则自动从系统 PATH 中查找。"/>
                        <TextBlock Text="留空则自动从系统 PATH 中查找 codebuddy 命令"
                                   Foreground="#AAA" FontSize="9"/>
                    </StackPanel>
                </Border>

                <!-- HTTP API Section -->
                <Border Background="#F0F8FC" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="🌐 HTTP API（CLI 不可用时回退）" FontWeight="Bold" Margin="0,0,0,6" FontSize="11"/>
                        <TextBlock Text="API 端点" Margin="0,0,0,4" FontSize="11"/>
                <TextBox x:Name="ApiEndpointBox" Margin="0,0,0,12"
                         ToolTip="兼容 OpenAI 的 API 端点 URL（如 https://api.openai.com/v1/chat/completions）"/>

                <TextBlock Text="API 密钥" Margin="0,0,0,4" FontSize="11"/>
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12"/>

                <TextBlock Text="模型名称" Margin="0,0,0,4" FontSize="11"/>
                <TextBox x:Name="ModelNameBox" Margin="0,0,0,12"
                         ToolTip="模型标识符（如 gpt-4、deepseek-chat）"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings -->
                <Border Background="#FAFAFA" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="⚙️ 高级设置" FontWeight="Bold" Margin="0,0,0,6" FontSize="11"/>

                <TextBlock Text="温度参数 (0.0 - 2.0)" Margin="0,0,0,4" FontSize="11"/>
                <TextBox x:Name="TemperatureBox" Margin="0,0,0,12"/>

                <TextBlock Text="最大令牌数" Margin="0,0,0,4" FontSize="11"/>
                <TextBox x:Name="MaxTokensBox" Margin="0,0,0,12"/>

                <TextBlock Text="超时时间（秒）" Margin="0,0,0,4" FontSize="11"/>
                <TextBox x:Name="TimeoutBox" Margin="0,0,0,12"/>

                <TextBlock Text="默认格式化风格" Margin="0,0,0,4" FontSize="11"/>
                <ComboBox x:Name="FormattingStyleBox" Margin="0,0,0,4"
                          ToolTip="AI 格式化功能使用的 SQL 格式化风格">
                    <ComboBoxItem Content="Microsoft" Tag="Microsoft"/>
                    <ComboBoxItem Content="Google" Tag="Google"/>
                </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="70" Height="26" Margin="0,0,8,0"
                    Click="Save_Click" Background="#0078D4" Foreground="White"/>
            <Button Content="取消" Width="70" Height="26"
                    Click="Cancel_Click" Background="#E0E0E0" Foreground="Black"/>
        </StackPanel>
    </Grid>
</Window>
