<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.SqlTemplateConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoostPlus - SQL 模板设置"
        Width="700" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#666">
            定义 SQL 模板缩写，在 SQL 编辑器中输入缩写后按 TAB 键展开。
            使用 $cursor 标记展开后光标的位置。
        </TextBlock>

        <!-- 模板列表 -->
        <DataGrid Grid.Row="1" Name="TemplateGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="缩写" Width="120"
                                    Binding="{Binding Abbreviation}"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="展开内容" Width="*"
                                    Binding="{Binding Expansion}"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 添加/编辑区域 -->
        <GroupBox Grid.Row="2" Header="添加/编辑模板" Margin="0,8,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="缩写:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Name="AbbreviationBox" Margin="0,0,8,4" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="（输入缩写后按 Tab 键展开）" VerticalAlignment="Center" Foreground="#999" Margin="8,0,0,4"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="展开内容:" VerticalAlignment="Top" Margin="0,4,8,0"/>
                    <TextBox Grid.Column="1" Name="ExpansionBox" Margin="0,0,0,4"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Name="AddButton" Content="添加/更新" Width="80" Margin="0,0,8,0" Padding="0,4"/>
                    <Button Name="DeleteButton" Content="删除选中" Width="80" Margin="0,0,8,0" Padding="0,4"/>
                    <Button Name="RestoreButton" Content="恢复默认" Width="80" Padding="0,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="CloseButton" Content="关闭" Width="80" Padding="0,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
