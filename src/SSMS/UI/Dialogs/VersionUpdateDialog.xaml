<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.VersionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoostPlus 更新"
        Width="380"
        Height="280"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded">

    <Border CornerRadius="8"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Margin="10">

        <Grid Margin="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔄"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="SSMSBoostPlus 更新可用"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#2E75B6"/>
                    <TextBlock x:Name="SummaryText"
                               Text="发现新版本"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Content="✕"
                        Width="24"
                        Height="24"
                        FontSize="12"
                        Foreground="#999999"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Version info bar -->
            <Border Grid.Row="1"
                    Background="#F5F9FC"
                    CornerRadius="4"
                    BorderBrush="#DEEBF7"
                    BorderThickness="1"
                    Margin="0,8,0,0"
                    Padding="8,6">
                <TextBlock x:Name="VersionInfoText"
                           FontSize="11"
                           Foreground="#444444"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Commit list (scrollable) -->
            <Border Grid.Row="2"
                    Background="#FAFAFA"
                    CornerRadius="4"
                    BorderBrush="#E8E8E8"
                    BorderThickness="1"
                    Margin="0,6,0,0"
                    Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           Foreground="#333333"
                                           TextWrapping="Wrap"
                                           Padding="3,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">

                <Button x:Name="UpdateButton"
                        Content="立即更新"
                        Width="80"
                        Height="26"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#2E75B6"
                        BorderBrush="#2E75B6"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnUpdateClick"
                        Margin="0,0,6,0"/>

                <Button x:Name="CloseFooterButton"
                        Content="稍后提醒"
                        Width="80"
                        Height="26"
                        FontSize="12"
                        Background="#F0F0F0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnCloseClick"/>
            </StackPanel>

        </Grid>
    </Border>

</Window>