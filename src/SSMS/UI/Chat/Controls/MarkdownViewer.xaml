<UserControl x:Class="SSMSBoostPlus.SSMS.UI.Chat.Controls.MarkdownViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">

    <Grid>
        <!-- WebView2 渲染 Markdown（Chromium 内核，替代 IE11 WebBrowser） -->
        <wv2:WebView2 x:Name="MarkdownWebView"
                       Visibility="Visible"
                       Margin="0"
                       HorizontalAlignment="Stretch"/>

        <!-- 空状态提示（Markdown 为空时显示，覆盖在 WebView2 上方） -->
        <TextBlock x:Name="EmptyPlaceholder"
                   Text="(无内容)"
                   FontSize="12"
                   Foreground="#94A3B8"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
    </Grid>

</UserControl>
