<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.ConnectionToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <Border CornerRadius="8"
            Background="#FFFFFF"
            BorderBrush="#0078D4"
            BorderThickness="1"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 信息图标（蓝白风格） -->
            <Grid Grid.Row="0" Grid.Column="0" Width="28" Height="28" Margin="0,0,14,0">
                <Ellipse Fill="#E3F2FD" Width="28" Height="28"/>
                <TextBlock Text="ℹ" FontSize="16" Foreground="#0078D4" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" Margin="0,-2,0,0"/>
            </Grid>

            <!-- 提示文字 -->
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="无法获取数据库连接"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="13"
                           Foreground="#555555"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" LineHeight="18"/>
            </StackPanel>

            <!-- 关闭按钮（用户可手动关闭） -->
            <Button Grid.Row="0" Grid.Column="2"
                    Content="✕"
                    Width="24" Height="24"
                    Padding="0"
                    FontSize="14"
                    Foreground="#666666"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    Margin="10,-4,-4,-4"
                    Click="OnCloseClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
