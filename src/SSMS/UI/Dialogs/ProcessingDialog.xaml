<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.ProcessingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoost++ - 处理中"
        Width="380" Height="140" MinWidth="300" MinHeight="120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0"
                   Text="正在处理..." FontSize="14"
                   Margin="0,0,0,12" Foreground="#333333"/>

        <ProgressBar x:Name="ProgressBar" Grid.Row="1"
                     IsIndeterminate="True"
                     Height="20" Margin="0,0,0,8"
                     Foreground="#0078D4"
                     Background="#E0E0E0"/>

        <TextBlock x:Name="DetailText" Grid.Row="2"
                   Text="" FontSize="11"
                   Foreground="#888888"/>
    </Grid>
</Window>