<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.VersionGuardConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSMSBoost++ - 版本守卫配置"
        Width="480" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ScrollViewerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="版本控制守卫配置" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="EnabledCheckBox" Content="启用版本守卫" Margin="0,0,0,12" IsChecked="True"/>

                <TextBlock Text="检测到不一致时的默认操作:" Margin="0,0,0,4"/>
                <StackPanel Margin="0,0,0,12">
                    <RadioButton x:Name="ActionStop" Content="停止执行" GroupName="Action" Margin="0,2"/>
                    <RadioButton x:Name="ActionAsk" Content="询问用户" GroupName="Action" IsChecked="True" Margin="0,2"/>
                    <RadioButton x:Name="ActionLog" Content="仅记录日志" GroupName="Action" Margin="0,2"/>
                </StackPanel>

                <TextBlock Text="跳过令牌（添加到脚本中以跳过检查）" Margin="0,0,0,4"/>
                <TextBox x:Name="SkipTokenBox" Margin="0,0,0,12"/>

                <TextBlock Text="确认令牌（添加到脚本中以强制弹出确认）" Margin="0,0,0,4"/>
                <TextBox x:Name="AskTokenBox" Margin="0,0,0,12"/>

                <CheckBox x:Name="CaseSensitiveCheckBox" Content="令牌区分大小写" Margin="0,0,0,12" IsChecked="True"/>
                <CheckBox x:Name="AutoRefreshCheckBox" Content="不一致时自动刷新" Margin="0,0,0,12"/>

                <TextBlock Text="排除的数据库（逗号分隔）" Margin="0,0,0,4"/>
                <TextBox x:Name="ExcludedDatabasesBox" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="80" Height="30" Margin="0,0,8,0"
                    Click="Save_Click" Background="#0078D4" Foreground="White"/>
            <Button Content="取消" Width="80" Height="30"
                    Click="Cancel_Click" Background="#E0E0E0" Foreground="Black"/>
        </StackPanel>
    </Grid>
</Window>
