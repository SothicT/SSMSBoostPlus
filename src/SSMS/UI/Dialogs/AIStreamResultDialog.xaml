<Window x:Class="SSMSBoostPlus.SSMS.UI.Dialogs.AIStreamResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SSMSBoost++ - AI 分析"
        Width="760" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- 超细滚动条 -->
        <Style x:Key="ThinScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 代码框样式（请求区只读显示） -->
        <Style x:Key="CodeBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- 区域标题样式 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- Row 0: 标题栏 -->
            <RowDefinition Height="36"/>
            <!-- Row 1: 状态栏 -->
            <RowDefinition Height="28"/>
            <!-- Row 2: 请求代码区 -->
            <RowDefinition Height="2*"/>
            <!-- Row 3: 分隔条 -->
            <RowDefinition Height="4"/>
            <!-- Row 4: 响应区 -->
            <RowDefinition Height="3*"/>
            <!-- Row 5: 底部按钮 -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ==================== Row 0: 标题栏 ==================== -->
        <Border Grid.Row="0" Background="#1A73E8" Padding="14,0">
            <Grid>
                <TextBlock x:Name="TitleText"
                           Text="AI 智能建议"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ElapsedText"
                           Text=""
                           FontSize="11"
                           Foreground="#B0D0FF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ==================== Row 1: 状态栏 ==================== -->
        <Border Grid.Row="1" Background="#F1F5F9" Padding="14,0"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="正在连接 AI 服务..."
                           FontSize="11" Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar"
                             Width="100" Height="10"
                             Margin="10,0,0,0"
                             IsIndeterminate="True"
                             Foreground="#1A73E8"
                             Background="#E2E8F0"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ==================== Row 2: 请求内容区 ==================== -->
        <Grid Grid.Row="2" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8FAFC" Padding="14,6,14,4"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="AI 请求内容"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="RequestSizeText"
                               FontSize="10" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 请求内容区：使用 WebView2 渲染 Markdown -->
            <wv2:WebView2 x:Name="RequestWebView" Grid.Row="1"
                          Visibility="Visible"
                          Margin="0"/>
        </Grid>

        <!-- ==================== Row 3: 分隔条 ==================== -->
        <GridSplitter Grid.Row="3"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="#E2E8F0"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ShowsPreview="True">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1A73E8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- ==================== Row 4: 响应区 ==================== -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8FAFC" Padding="14,6,14,4"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="AI 响应"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="ResponseSizeText"
                               FontSize="10" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- WebView2 替代 WebBrowser — 支持 fetch + ReadableStream 实时 SSE -->
            <wv2:WebView2 x:Name="ResponseWebView" Grid.Row="1"
                          Visibility="Visible"
                          Margin="0"/>
        </Grid>

        <!-- ==================== Row 5: 底部按钮 ==================== -->
        <Border Grid.Row="5" Background="#F8FAFC" Padding="14,0"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="CopyCodeButton"
                        Content="📝 复制代码"
                        Height="28" MinWidth="80"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Padding="10,0"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        Foreground="#475569"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="CopyCodeButton_Click"/>
                <Button x:Name="CopyButton"
                        Content="📋 复制响应"
                        Height="28" MinWidth="80"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Padding="10,0"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        Foreground="#475569"
                        Cursor="Hand"
                        Click="CopyButton_Click"/>
                <Button x:Name="CloseButton"
                        Content="关闭"
                        Height="28" MinWidth="70"
                        FontSize="11"
                        Padding="10,0"
                        Background="#1A73E8"
                        BorderBrush="#1A73E8"
                        Foreground="White"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
