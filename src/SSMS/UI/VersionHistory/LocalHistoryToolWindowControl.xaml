<UserControl x:Class="SSMSBoostPlus.SSMS.UI.VersionHistory.LocalHistoryToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="11">

    <UserControl.Resources>
        <!-- ChangeType color converters -->
        <ResourceDictionary>
            <!-- Primary button style -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="#0078D4"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#106EBE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#005A9E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Refresh button style -->
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ToggleButton style (for PinButton: TargetType 必须为 ToggleButton，不能复用 Button 样式) -->
            <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#E67E22"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Search ComboBox -->
        <Border Grid.Row="0" Margin="0,0,0,4" Padding="4,2"
                Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="4,0,4,0" FontSize="12"/>
                <ComboBox x:Name="ObjectSearchBox" Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          VerticalAlignment="Center"
                          BorderThickness="0"
                          FontSize="11"
                          Foreground="#666666"
                          FontStyle="Italic"
                          KeyDown="ObjectSearchBox_KeyDown"
                          SelectionChanged="ObjectSearchBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayText}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{Binding TypeColor}"
                                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeAbbreviation}" FontSize="9"
                                               Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ObjectCountLabel" Grid.Column="2"
                           Text="" VerticalAlignment="Center"
                           Foreground="#888888" FontSize="9"
                           Margin="6,0,4,0"/>
            </Grid>
        </Border>

        <!-- Row 1: DataGrid + 加载遮罩 -->
        <Grid Grid.Row="1">
            <DataGrid x:Name="VersionGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F8F8"
                  BorderBrush="#D0D0D0"
                  BorderThickness="1"
                  RowHeight="28"
                  SelectionChanged="VersionGrid_SelectionChanged"
                  MouseDoubleClick="VersionGrid_MouseDoubleClick"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制 SQL" Click="CopySql_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderBrush" Value="#D0D0D0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#CDE6F7"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="数据库名" Binding="{Binding DatabaseName}"
                                    Width="SizeToCells" MinWidth="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0078D4"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}"
                                    Width="36" CanUserResize="False"/>

                <DataGridTextColumn Header="时间" Binding="{Binding FormattedTime}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei"/>
                            <Setter Property="Foreground" Value="#555555"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="变更类型" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,1"
                                    Background="{Binding ChangeTypeColor}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ChangeType}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="操作人" Binding="{Binding LoginName}"
                                    Width="90"/>

                <DataGridTextColumn Header="版本" Binding="{Binding Version}"
                                    Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei"/>
                            <Setter Property="Foreground" Value="#888888"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            </DataGrid>

            <!-- 加载遮罩：列表加载期间覆盖网格，提供可见的「加载中」反馈 -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                    Background="#80FFFFFF">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ 加载中..."
                               FontSize="12" Foreground="#555555" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Status Bar -->
        <Border Grid.Row="2" Margin="0,4,0,0" Padding="6,3"
                Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ServerLabel" Grid.Column="0"
                           Text="" VerticalAlignment="Center"
                           Foreground="#0078D4" FontSize="10"
                           Background="Transparent"
                           Margin="0,0,4,0"
                           ToolTip="当前连接的服务器"/>
                <ComboBox x:Name="DatabaseComboBox" Grid.Column="1"
                          MinWidth="100" MaxWidth="200"
                          VerticalAlignment="Center"
                          FontSize="10"
                          Background="White"
                          IsEditable="False"
                          IsReadOnly="True"
                          SelectionChanged="DatabaseComboBox_SelectionChanged"
                          ToolTip="当前数据库（可切换）"/>
                <ToggleButton x:Name="PinButton" Grid.Column="2"
                              Content="📌"
                              Style="{StaticResource ToolbarToggleButton}"
                              ToolTip="钉住当前数据库（钉住后不受窗口切换影响）"
                              Click="PinButton_Click"/>
                <Button x:Name="SyncConnectionButton" Grid.Column="3"
                        Content="🔗 同步连接"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="重新检测当前 SSMS 活动连接并刷新全部数据"
                        Click="SyncConnectionButton_Click"/>
                <TextBlock x:Name="ConnectionStatusLabel" Grid.Column="4"
                           Text="" VerticalAlignment="Center"
                           Foreground="#888888" FontSize="9"
                           Margin="6,0,6,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="5"
                           Text="" VerticalAlignment="Center"
                           Foreground="#666666" FontSize="10"/>
                <Button x:Name="RefreshButton" Grid.Column="6"
                        Content="🔄 刷新版本"
                        Style="{StaticResource ToolbarButton}"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>